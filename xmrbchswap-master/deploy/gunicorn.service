[Unit]
Description=XMR BCH Swap Django (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/xmrbchswap/xmrbchswap-master
EnvironmentFile=/opt/xmrbchswap/xmrbchswap-master/.env
ExecStart=/opt/xmrbchswap/xmrbchswap-master/.venv/bin/gunicorn \
  --bind 127.0.0.1:8000 \
  --workers 3 \
  --timeout 60 \
  xmrbchswap.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
