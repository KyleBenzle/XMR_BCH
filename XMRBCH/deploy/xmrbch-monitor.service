[Unit]
Description=XMRTo.Cash deposit monitor / payout worker
After=network-online.target xmrbch-wallet.service
Wants=network-online.target

[Service]
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python manage.py monitor
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
