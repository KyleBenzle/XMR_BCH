# ─────────────────────────────────────────────────────────────────────────────
# XMRTo.Cash configuration. Copy to .env (install.sh does this) and edit.
# Restart services after changes:  sudo systemctl restart xmrbch-web xmrbch-monitor xmrbch-wallet
# ─────────────────────────────────────────────────────────────────────────────

# ── Network: true = BCH testnet + XMR stagenet (fake money), false = MAINNET ──
TESTNET=true

# ── Website ──────────────────────────────────────────────────────────────────
# Site is served at https://yourdomain.com/XMRBCH/  (must match the folder name
# if you use the .htaccess / public_html setup). Empty = domain root.
URL_PREFIX=XMRBCH
WEB_PORT=8077
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=   (leave unset: one is generated in data/secret_key)

# ── BCH operational wallet (pays users; receives swept deposits) ─────────────
# Generate with: .venv/bin/python manage.py generate_wallets
BCH_OPERATIONAL_WIF=

# ── Monero wallet (monero-wallet-rpc runs on this server) ────────────────────
XMR_WALLET_FILE=data/xmr_wallet
XMR_WALLET_PASSWORD=
# Leave empty to use a public node for the selected network.
XMR_DAEMON_ADDRESS=
XMR_RPC_HOST=127.0.0.1
XMR_RPC_PORT=18083
# Optional RPC login (recommended on shared machines)
XMR_RPC_USER=
XMR_RPC_PASS=

# ── Exchange ─────────────────────────────────────────────────────────────────
FEE_PERCENT=5.0
MIN_BCH=0.001
MIN_XMR=0.01
SWAP_EXPIRY_HOURS=24
LATE_DEPOSIT_GRACE_DAYS=7
SWAPS_PER_IP_PER_HOUR=20

# ── Monitor ──────────────────────────────────────────────────────────────────
MONITOR_INTERVAL_SECONDS=30
BCH_MIN_CONFIRMATIONS=1
XMR_MIN_CONFIRMATIONS=10
